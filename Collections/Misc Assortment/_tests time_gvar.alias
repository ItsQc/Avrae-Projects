embed <drac2>
# Makeshift unit tests for gregorian-unix time gvar
GVAR = "a2cd0576-5d24-4b36-8795-40586784aee7"
using(gtime=GVAR)
EXPECTED = "expected"
GIVEN = "given"
nl = '\n'

Tests = {
    "leap_year": [{GIVEN: 1970, EXPECTED: False}, {GIVEN: 2000, EXPECTED: True,}, {GIVEN: 1800, EXPECTED: False}, {GIVEN: 1604, EXPECTED: True}],
}
template = ' | '.join(("Result?", "number passed", "total tests", "failed for"))
results = [template]

# Start tests
startTime = time()
scores = []
reason = []
fails = []
for i in range(len(Tests["leap_year"])):
    try:
        test = gtime.leap_year(Tests["leap_year"][i][GIVEN])
        if test == Tests["leap_year"][i][EXPECTED]: 
            scores.append(True)
        elif not typeof(test, boolean):
            scores.append(False)
            fails.append(i)
            reason.append(test)
        else:
            scores.append(False)
            fails.append(i)
            reason.append(Tests["leap_year"][i][GIVEN])
    except:
        scores.append(False)
        reason.append(f'Errored on: {Tests["leap_year"][i][GIVEN]}')
        fails.append(i)
results.append(' | \t '.join(["Pass" if all(scores) else "Fail", str(scores.count(True)), str(len(scores)), str(reason)]))

testTime = time() - startTime

return f'-desc "{nl.join(results)}" -f "Testing time|{testTime:4g}" -f "gvar id|{GVAR}" '
</drac2>